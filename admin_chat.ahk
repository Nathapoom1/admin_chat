#Requires AutoHotkey v2.0
#SingleInstance Force

; ฟังก์ชันส่งข้อความภาษาไทยผ่าน Clipboard เพื่อป้องกันสระเพี้ยน
SendThai(text) {
    savedClip := A_Clipboard
    A_Clipboard := text
    ClipWait(1)
    Send("^v")
    Sleep(100)
    A_Clipboard := savedClip
}

; กด Ctrl+Alt+S เพื่อเปิด/ปิดข้อความลัดชั่วคราว
#SuspendExempt
^!s::
{
    Suspend(-1)
    ToolTip(A_IsSuspended ? "ปิดข้อความลัดแล้ว" : "เปิดข้อความลัดแล้ว")
    SetTimer(() => ToolTip(), -1500)
}
#SuspendExempt False

; กด Ctrl+Alt+H เพื่อดูว่าแต่ละปุ่มใช้ส่งข้อความอะไร
^!h::
{
    shortcuts := "รายการข้อความลัด`n`n"
        . "F1 = ข้อความต้อนรับ`n"
        . "F2 = เงื่อนไขการฝาก-ถอน`n"
        . "F3 = สอบถามรหัสผ่าน`n"
        . "F4 = สนใจสมัครสมาชิก`n"
        . "F5 = ติดปัญหาเข้าระบบ`n"
        . "F6 = กำลังทำรายการ`n"
        . "F7 = ขอข้อมูลสมาชิก`n"
        . "F8 = รอตรวจสอบ"
    MsgBox(shortcuts, "ข้อความลัดแอดมิน")
}

; กด F1 เพื่อส่งข้อความต้อนรับ
F1::
{
    SendThai("📌สมัครสมาชิก คุณพี่กรอกข้อมูลให้น้องริชชี่ได้เลยนะคะ💕`n👤ชื่อ + สกุล :`n📞เบอร์โทร :`n📗LINE ID :`n💸ธนาคาร/เลขบัญชี  (หรือวอลเลท):`n🔴(ชื่อบัญชีต้องตรงกับชื่อผู้สมัคร)🔴")
}

; กด F2 เพื่อส่งเงื่อนไขการฝาก-ถอน
F2::
{
    SendThai("✨เงื่อนไขการฝาก-ถอน✨`n👉ฝากไม่มีขั้นต่ำ`n👉ถอนไม่มีขั้นต่ำ`n👉ไม่ต้องทำเทิร์น")
}

; กด F3 เพื่อส่งข้อความสอบถามรหัสผ่าน
F3::
{
    SendThai("กรณีที่ลูกค้าต้องการทราบรหัสผ่าน รบกวนแจ้งข้อมูลให้น้องริชชี่ด้วยนะคะ`n👤 ชื่อ - สกุล :`n💰 เลขบัญชี :`n💸 ธนาคาร :`n🛑🛑(ชื่อบัญชีต้องตรงกับชื่อผู้สมัคร)🛑🛑")
}

F4::
{
    SendThai("💚สนใจสมัครสมาชิกแจ้งข้อมูลได้เลยค่ะ")
}

F5::
{
    SendThai("🙏ติดปัญหาตรงไหน เข้าระบบไม่ได้ แจ้งน้องได้เลยนะคะ`nหรือหากสะดวกฝากเมื่อไหร่ แจ้งสลิปได้ ตลอด 24 ชมค่ะ🙏")
}

F6::
{
    SendThai("🕔 น้องกำลังทำรายการให้รบกวนคุณพี่รอ 1-3 นาทีค่ะ 🕔")
}

F7::
{
    SendThai("รบกวนคุณพี่แจ้งข้อมูลให้น้องแอดมินด้วยนะคะ 😇`n1️⃣ชื่อ - สกุล`n2️⃣ID Line`n3️⃣เบอร์โทรศัพท์`n4️⃣เลขบัญชี + ชื่อธนาคารคุณ")
}

F8::
{
    SendThai("💖รอตรวจสอบสักครู่นะคะ💖")
}